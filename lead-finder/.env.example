# --- Required ---
# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or local).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/leadfinder"
# Random secret for sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Random secret that protects the scheduled-job endpoint. Vercel Cron sends it automatically.
CRON_SECRET=""

# --- Used only by `npm run db:seed` ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# --- Optional ---
# Google Places API (New) key. Enables the business directory source.
GOOGLE_PLACES_API_KEY=""
# Enables the "Personalize draft" button. The app works fully without it.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Set to "true" only when running behind a trusted proxy that is not Vercel.
AUTH_TRUST_HOST=""
